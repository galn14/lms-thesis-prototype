# Prototype safety
PROTOTYPE_MODE=true
NEXT_PUBLIC_PROTOTYPE_MODE=true
PROTOTYPE_INSTALLATION_ID=00000000-0000-4000-8000-000000000000

# Neon Postgres
# DATABASE_URL and AUX_POSTGRES_URL must contain the same pooled Neon URL.
DATABASE_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/db?sslmode=require
AUX_POSTGRES_URL=postgresql://user:password@ep-example-pooler.ap-southeast-1.aws.neon.tech/db?sslmode=require
# Use the direct, non-pooler URL only for Prisma and auxiliary migrations.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.ap-southeast-1.aws.neon.tech/db?sslmode=require

# Authentication and reset
NEXTAUTH_SECRET=replace-with-a-random-secret
NEXTAUTH_URL=https://replace-with-your-project.vercel.app
CREDENTIAL_ENCRYPTION_SECRET=replace-with-a-different-random-secret
CRON_SECRET=replace-with-a-random-secret
DEMO_SHARED_PASSWORD=replace-before-seeding

# Provider API keys are intentionally unsupported in prototype deployments.

# Local preparation only; never synchronize these values to Vercel.
NEON_API_KEY=replace-with-a-neon-api-key
NEON_PROJECT_ID=replace-with-the-neon-project-id
NEON_PRODUCTION_BRANCH_ID=replace-with-the-production-branch-id
READINESS_HMAC_KEY=replace-with-an-independent-32-byte-random-secret
