{
  "name": "lms-thesis-prototype",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "ESLINT_USE_FLAT_CONFIG=false eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:pull": "prisma db pull",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test": "jest",
    "test:coverage": "jest --coverage --runInBand",
    "validate:prototype": "node scripts/prototype/cli/validate-env.cjs",
    "validate:vercel-production": "node scripts/prototype/cli/validate-vercel-production.cjs",
    "db:migrate:prototype": "node scripts/prototype/cli/prisma-migrate.cjs",
    "db:migrate:aux": "node --import tsx scripts/prototype/migrate-auxiliary.ts",
    "db:reset:prototype": "node --import tsx scripts/prototype/reset.ts",
    "scan:secrets": "node scripts/prototype/cli/scan-secrets.cjs",
    "scan:artifacts": "node scripts/prototype/cli/scan-artifacts.cjs",
    "release:prototype": "node scripts/prototype/cli/release.cjs"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@prisma/client": "^6.8.2",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-slot": "^1.2.3",
    "@tiptap/pm": "^2.13.0",
    "@tiptap/react": "^2.13.0",
    "@tiptap/starter-kit": "^2.13.0",
    "@types/bcryptjs": "^3.0.0",
    "@types/crypto-js": "^4.2.2",
    "@types/pg": "^8.15.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "franc-min": "^6.2.0",
    "lucide-react": "^0.485.0",
    "next": "15.2.3",
    "next-auth": "^4.24.11",
    "openai": "^6.9.1",
    "pg": "^8.16.0",
    "postgres": "^3.4.7",
    "prisma": "^6.8.2",
    "react": "^19.0.0",
    "react-day-picker": "^9.7.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "tailwind-merge": "^3.0.2",
    "tw-animate-css": "^1.2.5",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^16.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.2.3",
    "jest": "^30.2.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.6",
    "tsx": "4.21.0",
    "typescript": "^5",
    "vercel": "59.1.3"
  }
}
